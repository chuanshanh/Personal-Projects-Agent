LLM_PROVIDER = "openai-compatible"
LLM_MODEL = "deepseek-v4-flash"
LLM_BASE_URL = "https://api.deepseek.com"
LLM_API_KEY = "replace-with-your-deepseek-api-key"

# This example is safe to commit. Never put a real key in this file.
# For local use, copy it to .streamlit/secrets.toml (ignored by Git).
# For Community Cloud, paste the four values into Advanced settings > Secrets.
